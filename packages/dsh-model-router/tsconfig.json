{
  // Package project for the Typert host face and the declaration half of the
  // build. The root tsconfig.host.json aggregates this file, which is how the
  // typert generator discovers the package
  // (packages/typert/generator/src/analyzer.ts:481-489).
  //
  // JavaScript is emitted by tsdown from the TypeScript sources; this project
  // emits declarations only, into lib/types, which is what exports "." points
  // its `types` condition at (the same two-artifact split DSH uses:
  // packages/experimental/client-ui-cot-translation/tsconfig.host.json).
  //
  // src/client is excluded: the browser half is bundled by tsdown without a
  // type-check pass (it predates this build as hand-written JavaScript), and the
  // Typert host-face program must not compile browser modules.
  //
  // target es2024 (DSH's own base target): the host half uses `using` with the
  // disposable deadline from @deepseek-ai/dsh-timeout, which needs the
  // Symbol.dispose lib. The client bundle keeps its own es2022 target in
  // tsdown.config.ts — the browser half never touches that primitive.
  "compilerOptions": {
    "target": "es2024",
    // `using` with the disposable deadline needs the explicit-resource-management
    // lib; it is not part of the plain es2024 lib set. `dom` stays because the
    // host half talks to AbortSignal/setInterval and the default lib set (which
    // this replaces) included it.
    "lib": ["es2024", "esnext.disposable", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
