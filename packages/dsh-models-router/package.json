{
  "name": "dsh-models-router",
  "version": "0.2.0",
  "description": "Transparent cross-provider failover for DSH Agent main requests: named fallback chains, per-session chain choice, per-route retry overrides.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "failover",
    "fallback",
    "router",
    "retry",
    "model-routing"
  ],
  "homepage": "https://github.com/Imzl-zl/dsh-models-router#readme",
  "bugs": {
    "url": "https://github.com/Imzl-zl/dsh-models-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imzl-zl/dsh-models-router.git",
    "directory": "packages/dsh-models-router"
  },
  "author": "Imzl-zl",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "npm run bundle"
  },
  "main": "lib/index.js",
  "files": [
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "src/",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
